# Supabase local usa o banco e o usuário "postgres" por padrão.
# Defina a senha antes da primeira inicialização; o start.sh usa o mesmo valor na API.
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_LOCAL_DB_PASSWORD=postgres

# Conexão local com o PostgreSQL do Supabase. Para usar um projeto hospedado,
# configure manualmente a URL, usuário e senha da API Spring.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:54322/postgres?sslmode=disable
SPRING_JPA_DDL_AUTO=validate
SERVER_PORT=8088
AGENT_INVITE_CODE=rota-agente-local
SESSION_HOURS=12
CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8088/api

# Assistente conversacional via protocolo OpenAI-compatible (Maritaca AI).
# A chave permanece no back-end e não é enviada ao navegador.
OPENAI_BASE_URL=https://chat.maritaca.ai/api
OPENAI_MODEL=sabiazinho-4
OPENAI_API_KEY=
OPENAI_MAX_TOKENS=900
